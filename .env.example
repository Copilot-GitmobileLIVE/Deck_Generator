# ── API Keys ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY="YOUR_OPENAI_API_KEY_HERE"
GEMINI_API_KEY=AIza...

# ── Model Selection ───────────────────────────────────────────────────────────
MODEL_CONTENT=gpt-4o
MODEL_IMAGE_OPENAI=gpt-image-2
MODEL_IMAGE_GEMINI=gemini-2.5-flash-preview-05-20
MODEL_REVIEW=gpt-4o
MODEL_LAYOUT=gpt-4o
MODEL_QA=gpt-4o

# ── Output Paths ──────────────────────────────────────────────────────────────
OUTPUT_DIR=output
IMAGES_DIR=output/images

# ── Workflow Tuning ───────────────────────────────────────────────────────────
MAX_RETRIES=2
IMAGE_GENERATION_TIMEOUT=120
CONTENT_TEMPERATURE=0.4
REVIEW_TEMPERATURE=0.1
